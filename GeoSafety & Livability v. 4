        // แสดงข้อมูลตำแหน่งที่ตั้งลงใน UI แดชบอร์ด
        ฟังก์ชัน loadLocationData(key) {
            const data = locationData[key];
            ถ้า (!data) ให้ส่งคืน;

            currentLocKey = key;

            // ซิงค์เมนูแบบเลื่อนลงหากทำได้
            const dropdown = document.getElementById('provinceSelect');
            ถ้า dropdown มีค่าเท่ากับ key;

            // ตั้งชื่อเรื่องและส่วนหัว
            document.getElementById('locTitle').innerText = data.title;
            document.getElementById('locSub').innerText = data.subtitle;
            document.getElementById('overallScore').innerText = data.overall;
            document.getElementById('livabilityGrade').innerText = data.grade;
            document.getElementById('voteAreaName').innerText = data.title;

            // ป้ายแสดงความเสี่ยง
            const riskBadge = document.getElementById('riskBadge');
            riskBadge.innerText = data.riskBadge.text;
            riskBadge.className = `px-3 py-1 rounded-full text-xs font-bold border whitespace-nowrap ${data.riskBadge.class}`;

            // สถิติโดยย่อ
            document.getElementById('quickSafety').innerText = data.quick.safety;
            document.getElementById('quickEnv').innerText = data.quick.env;
            document.getElementById('quickConvenience').innerText = data.quick.convenience;

            // คะแนน
            document.getElementById('scoreSafety').innerText = `${data.scores.safety}/100`;
            document.getElementById('scoreEnv').innerText = `${data.scores.env}/100`;
            document.getElementById('scoreInfra').innerText = `${data.scores.infra}/100`;
            document.getElementById('scoreTransit').innerText = `${data.scores.transit}/100`;
            document.getElementById('scoreGreen').innerText = `${data.scores.green}/100`;

            // รายละเอียดด้านสิ่งแวดล้อมและโครงสร้างพื้นฐาน
            document.getElementById('floodStatus').innerText = data.flood.status;
            document.getElementById('floodBar').style.width = `${data.flood.percent}%`;
            document.getElementById('pmStatus').innerText = data.pm.status;
            document.getElementById('pmBar').style.width = `${data.pm.percent}%`;

            document.getElementById('hospitalDist').innerText = data.hospital;
            document.getElementById('policeDist').innerText = data.police;
