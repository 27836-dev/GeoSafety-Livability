        ฟังก์ชัน generateThailandAreaProfile(title, province, lat, lng) {
            // กำหนดค่า seed ที่แน่นอนจากชื่อเรื่องและพิกัด เพื่อให้ได้คะแนนที่สม่ำเสมอในสถานที่เดียวกันเสมอ
