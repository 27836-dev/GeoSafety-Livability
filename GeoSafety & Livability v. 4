        // ตัวจัดการการค้นหาข้อความสำหรับทุกสถานที่ในประเทศไทย
        ฟังก์ชัน performSearch() {
            const query = document.getElementById('searchInput').value.trim();
            ถ้า (!query) {
                showToast('กรุณาป้อนชื่อสถานที่หรือ/ จังหวัดที่ต้องการป้อน');
                ส่งคืน;
            }

            // ตรวจสอบว่าตรงกับคีย์ที่ตั้งไว้ล่วงหน้าหรือไม่
            const lowerQ = query.toLowerCase();
            let matchedKey = Object.keys(locationData).find(k => k.toLowerCase() === lowerQ || locationData[k].title.toLowerCase().includes(lowerQ));

            ถ้า (matchedKey) {
                โหลดข้อมูลตำแหน่ง(matchedKey);
                showToast(` รับข้อมูล: ${locationData[matchedKey].title}`);
            } มิฉะนั้น {
                // สร้างโปรไฟล์แบบไดนามิกสำหรับสถานที่ใดๆ ในประเทศไทยที่ระบุ
                const dynamicKey = `search_${query}`;
                ถ้า (!locationData[dynamicKey]) {
                    locationData[dynamicKey] = GenerateThailandAreaProfile(query, "ประเทศไทย", 13.7563, 100.5018);
                }
                โหลดข้อมูลตำแหน่ง (dynamicKey);
                showToast(`ผลลัพธ์ผลลัพธ์: ${query}`);
            }
        }

