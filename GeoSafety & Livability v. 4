            const commentText = document.getElementById('voteCommentInput').value.trim();
            const selectedTagEls = document.querySelectorAll('.selected-tag');
            const tags = Array.from(selectedTagEls).map(el => el.innerText);

            ถ้า (!locationData[currentLocKey].votes) {
                locationData[currentLocKey].votes = { total: 0, avg: 5.0, counts: { 5:0, 4:0, 3:0, 2:0, 1:0 }, reviews: [] };
            }

            const v = locationData[currentLocKey].votes;
            v.total += 1;
            v.counts[selectedUserRating] = (v.counts[selectedUserRating] || 0) + 1;
            
