        // Text Search Handler for any location in Thailand
        function performSearch() {
            const query = document.getElementById('searchInput').value.trim();
            if (!query) {
                showToast('กรุณากรอกชื่อสถานที่หรืออำเภอ/จังหวัดที่ต้องการค้นหา');
                return;
            }

            // Check if matches any preset keys
            const lowerQ = query.toLowerCase();
            let matchedKey = Object.keys(locationData).find(k => k.toLowerCase() === lowerQ || locationData[k].title.toLowerCase().includes(lowerQ));

            if (matchedKey) {
                loadLocationData(matchedKey);
                showToast(`พบข้อมูลพื้นที่: ${locationData[matchedKey].title}`);
            } else {
                // Generate a dynamic profile for any typed location in Thailand
                const dynamicKey = `search_${query}`;
                if (!locationData[dynamicKey]) {
                    locationData[dynamicKey] = generateThailandAreaProfile(query, "ประเทศไทย", 13.7563, 100.5018);
                }
                loadLocationData(dynamicKey);
                showToast(`ประเมินผลพื้นที่: ${query}`);
            }
        }

        // Dropdown Selection Handler
        function selectLocationByDropdown() {
            const val = document.getElementById('provinceSelect').value;
            if (val && locationData[val]) {
                loadLocationData(val);
            }
        }

        // Render Location Data into Dashboard UI
        function loadLocationData(key) {
            const data = locationData[key];
            if (!data) return;

            currentLocKey = key;

            // Sync dropdown if applicable
            const dropdown = document.getElementById('provinceSelect');
            if (dropdown) dropdown.value = key;

            // Set Title & Header
            document.getElementById('locTitle').innerText = data.title;
            document.getElementById('locSub').innerText = data.subtitle;
            document.getElementById('overallScore').innerText = data.overall;
            document.getElementById('livabilityGrade').innerText = data.grade;
            document.getElementById('voteAreaName').innerText = data.title;

            // Risk Badge
            const riskBadge = document.getElementById('riskBadge');
            riskBadge.innerText = data.riskBadge.text;
            riskBadge.className = `px-3 py-1 rounded-full text-xs font-bold border whitespace-nowrap ${data.riskBadge.class}`;

            // Quick Stats
            document.getElementById('quickSafety').innerText = data.quick.safety;
            document.getElementById('quickEnv').innerText = data.quick.env;
            document.getElementById('quickConvenience').innerText = data.quick.convenience;

            // Scores
            document.getElementById('scoreSafety').innerText = `${data.scores.safety}/100`;
            document.getElementById('scoreEnv').innerText = `${data.scores.env}/100`;
            document.getElementById('scoreInfra').innerText = `${data.scores.infra}/100`;
            document.getElementById('scoreTransit').innerText = `${data.scores.transit}/100`;
            document.getElementById('scoreGreen').innerText = `${data.scores.green}/100`;

            // Environment & Infrastructure details
            document.getElementById('floodStatus').innerText = data.flood.status;
            document.getElementById('floodBar').style.width = `${data.flood.percent}%`;
            document.getElementById('pmStatus').innerText = data.pm.status;
            document.getElementById('pmBar').style.width = `${data.pm.percent}%`;

            document.getElementById('hospitalDist').innerText = data.hospital;
            document.getElementById('policeDist').innerText = data.police;
            document.getElementById('transitAccess').innerText = data.transit;
            document.getElementById('trafficStatus').innerText = data.traffic.status;
            document.getElementById('trafficBar').style.width = `${data.traffic.percent}%`;

            document.getElementById('parkDist').innerText = data.park;
            document.getElementById('noiseStatus').innerText = data.noise;

            // Render Alert Box List
            const alertContainer = document.getElementById('alertBoxList');
            alertContainer.innerHTML = '';
            data.alerts.forEach(alert => {
                const item = document.createElement('div');
                item.className = 'flex items-start space-x-3 p-3 bg-slate-50 dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-700/40 text-xs sm:text-sm';
                item.innerHTML = `
                    <div class="mt-0.5">
                        <i data-lucide="${alert.icon}" class="w-4 h-4 ${alert.color}"></i>
                    </div>
                    <div>
                        <span class="font-semibold text-slate-900 dark:text-white">${alert.title}:</span>
                        <span class="text-slate-600 dark:text-slate-300 ml-1">${alert.desc}</span>
                    </div>
                `;
                alertContainer.appendChild(item);
            });

            // Render Recommendations
            const recContainer = document.getElementById('recommendationList');
            recContainer.innerHTML = '';
            data.recommendations.forEach(rec => {
                const li = document.createElement('li');
                li.className = 'flex items-start gap-2 bg-slate-50 dark:bg-slate-900/40 p-2.5 rounded-lg border border-slate-200 dark:border-slate-700/30';
                li.innerHTML = `
                    <i data-lucide="chevron-right" class="w-4 h-4 text-sky-600 dark:text-sky-400 mt-0.5 flex-shrink-0"></i>
                    <span>${rec}</span>
                `;
                recContainer.appendChild(li);
            });

            // Render Map Pins
            renderMapPins(data.pins);

            // Render Community Votes & Reviews
            renderCommunitySection(data.votes);

            // Refresh Lucide Icons for dynamic content
            lucide.createIcons();
            showToast(`โหลดข้อมูลพื้นที่: ${data.title}`);
        }

        // --- Community Voting System Functions ---
        function setRating(val) {
            selectedUserRating = val;
            const labels = ["", "1 ดาว - ควรปรับปรุงมาก", "2 ดาว - พอใช้", "3 ดาว - ปานกลาง", "4 ดาว - น่าอยู่ ปลอดภัย", "5 ดาว - ดีเยี่ยม น่าอยู่มาก"];
            document.getElementById('selectedRatingText').innerText = labels[val];

            const stars = document.querySelectorAll('.star-btn');
            stars.forEach(btn => {
                const starVal = parseInt(btn.getAttribute('data-val'));
                const svg = btn.querySelector('svg');
                if (starVal <= val) {
                    btn.classList.add('text-amber-500', 'dark:text-amber-400', 'bg-amber-50', 'dark:bg-amber-500/10', 'border-amber-400', 'dark:border-amber-500/30');
                    btn.classList.remove('text-slate-400', 'bg-white', 'dark:bg-slate-800', 'border-slate-200', 'dark:border-slate-700');
                    if (svg) svg.classList.add('fill-amber-500', 'dark:fill-amber-400');
                } else {
                    btn.classList.remove('text-amber-500', 'dark:text-amber-400', 'bg-amber-50', 'dark:bg-amber-500/10', 'border-amber-400', 'dark:border-amber-500/30');
                    btn.classList.add('text-slate-400', 'bg-white', 'dark:bg-slate-800', 'border-slate-200', 'dark:border-slate-700');
                    if (svg) svg.classList.remove('fill-amber-500', 'dark:fill-amber-400');
                }
            });
        }

        function toggleVoteTag(btn) {
            btn.classList.toggle('bg-sky-500/15');
            btn.classList.toggle('dark:bg-sky-600/30');
            btn.classList.toggle('border-sky-500');
            btn.classList.toggle('dark:border-sky-400');
            btn.classList.toggle('text-sky-700');
            btn.classList.toggle('dark:text-white');
            btn.classList.toggle('selected-tag');
        }

        function submitCommunityVote() {
            if (selectedUserRating === 0) {
                showToast('กรุณาเลือกจำนวนดาวเพื่อให้คะแนนก่อนส่งโหวตครับ');
                return;
            }

            const commentText = document.getElementById('voteCommentInput').value.trim();
            const selectedTagEls = document.querySelectorAll('.selected-tag');
            const tags = Array.from(selectedTagEls).map(el => el.innerText);

            if (!locationData[currentLocKey].votes) {
                locationData[currentLocKey].votes = { total: 0, avg: 5.0, counts: { 5:0, 4:0, 3:0, 2:0, 1:0 }, reviews: [] };
            }

            const v = locationData[currentLocKey].votes;
            v.total += 1;
            v.counts[selectedUserRating] = (v.counts[selectedUserRating] || 0) + 1;
            
            let totalScoreSum = 0;
            for (let s = 1; s <= 5; s++) {
                totalScoreSum += s * (v.counts[s] || 0);
            }
            v.avg = (totalScoreSum / v.total).toFixed(1);

            if (commentText || tags.length > 0) {
                v.reviews.unshift({
                    user: "คุณ (ผู้ใช้งานปัจจุบัน)",
                    rating: selectedUserRating,
                    tags: tags,
                    comment: commentText || "ให้คะแนนพื้นที่เรียบร้อยแล้ว",
                    time: "เมื่อสักครู่"
                });
            }

            renderCommunitySection(v);
            showToast('บันทึกคะแนนเสียงและรีวิวพื้นที่ของคุณเรียบร้อยแล้ว ขอบคุณครับ!');
            
            // Reset form
            selectedUserRating = 0;
            setRating(0);
            document.getElementById('voteCommentInput').value = '';
            selectedTagEls.forEach(el => {
                el.classList.remove('bg-sky-500/15', 'dark:bg-sky-600/30', 'border-sky-500', 'dark:border-sky-400', 'text-sky-700', 'dark:text-white', 'selected-tag');
            });
        }

        function renderCommunitySection(votes) {
            document.getElementById('totalVotesCount').innerText = votes.total;
            document.getElementById('communityAvgRating').innerText = votes.avg;

            // Render Breakdown bars
            const barsContainer = document.getElementById('voteDistributionBars');
            barsContainer.innerHTML = '';
            for (let star = 5; star >= 1; star--) {
                const count = votes.counts[star] || 0;
                const pct = votes.total > 0 ? Math.round((count / votes.total) * 100) : 0;
                const row = document.createElement('div');
                row.className = 'flex items-center gap-2';
                row.innerHTML = `
                    <span class="w-8 text-slate-500 dark:text-slate-400 font-medium">${star} ดาว</span>
                    <div class="flex-1 bg-slate-200 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
                        <div class="bg-amber-500 dark:bg-amber-400 h-full rounded-full" style="width: ${pct}%"></div>
                    </div>
                    <span class="w-8 text-right text-slate-400">${count}</span>
                `;
                barsContainer.appendChild(row);
            }

            // Render Reviews list
            const revContainer = document.getElementById('communityReviewsList');
            revContainer.innerHTML = '';
            if (!votes.reviews || votes.reviews.length === 0) {
                revContainer.innerHTML = `<p class="text-xs text-slate-400 italic">ยังไม่มีความคิดเห็นในพื้นที่นี้ เป็นคนแรกที่รีวิวเลย!</p>`;
                return;
            }

            votes.reviews.forEach(rev => {
                const card = document.createElement('div');
                card.className = 'bg-white dark:bg-slate-800/80 p-3 rounded-xl border border-slate-200 dark:border-slate-700/60 text-xs space-y-1.5 shadow-sm';
                
                let tagsHtml = '';
                if (rev.tags && rev.tags.length > 0) {
                    tagsHtml = `<div class="flex flex-wrap gap-1 mt-1">` + rev.tags.map(t => `<span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-md text-[10px]">${t}</span>`).join('') + `</div>`;
                }

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="font-semibold text-slate-900 dark:text-white">${rev.user}</span>
                        <div class="flex items-center gap-1 text-amber-500">
                            <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-500"></i>
                            <span class="font-bold text-slate-700 dark:text-slate-200">${rev.rating}</span>
                            <span class="text-[10px] text-slate-400 ml-1">• ${rev.time}</span>
                        </div>
                    </div>
                    <p class="text-slate-600 dark:text-slate-300">${rev.comment}</p>
                    ${tagsHtml}
                `;
                revContainer.appendChild(card);
            });
            lucide.createIcons();
        }

        // Render Map Pins based on active filter
        function renderMapPins(pins) {
            const container = document.getElementById('mapPinsContainer');
            container.innerHTML = '';

            pins.forEach(pin => {
                if (activeFilter !== 'all' && pin.type !== activeFilter) return;

                let colorClass = 'bg-emerald-500 border-emerald-200 text-emerald-900';
                let iconName = 'shield';
                if (pin.type === 'health') {
                    colorClass = 'bg-rose-500 border-rose-200 text-rose-900';
                    iconName = 'hospital';
                } else if (pin.type === 'risk') {
                    colorClass = 'bg-amber-500 border-amber-200 text-amber-900';
                    iconName = 'alert-triangle';
                }

                const el = document.createElement('div');
                el.className = 'absolute transform -translate-x-1/2 -translate-y-1/2 cursor-pointer group';
                el.style.top = pin.top;
                el.style.left = pin.left;
                el.innerHTML = `
                    <div class="p-2 rounded-full shadow-lg ${colorClass} text-white flex items-center justify-center transition transform group-hover:scale-125">
                        <i data-lucide="${iconName}" class="w-3.5 h-3.5"></i>
                    </div>
                    <div class="absolute left-1/2 -translate-x-1/2 bottom-full mb-1 hidden group-hover:block whitespace-nowrap px-2 py-1 bg-slate-900/90 text-white text-[10px] rounded shadow-md z-30">
                        ${pin.label}
                    </div>
                `;
                container.appendChild(el);
            });
            lucide.createIcons();
        }

        function toggleMapFilter(type) {
            activeFilter = type;
            ['all', 'safety', 'health', 'risk'].forEach(t => {
                const btn = document.getElementById(`btnFilter${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (btn) {
                    if (t === type) {
                        btn.className = 'px-3 py-1.5 rounded-lg bg-sky-600 text-white font-medium shadow';
                    } else {
                        btn.className = 'px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 font-medium transition';
                    }
                }
            });
            if (locationData[currentLocKey]) {
                renderMapPins(locationData[currentLocKey].pins);
            }
        }

        // Dynamic Area Risk & Livability Analyzer for any coordinate in Thailand
        function generateThailandAreaProfile(title, province, lat, lng) {
            let hash = 0;
            const seedStr = `${title}_${lat.toFixed(2)}_${lng.toFixed(2)}`;
            for (let i = 0; i < seedStr.length; i++) {
                hash = ((hash << 5) - hash) + seedStr.charCodeAt(i);
                hash |= 0;
            }
            const rand = (min, max, offset = 0) => {
                const x = Math.abs(Math.sin(hash + offset) * 10000);
                return Math.floor((x - Math.floor(x)) * (max - min + 1)) + min;
            };

            let region = "ภาคกลาง";
            let regionalAlert = { icon: "cloud-rain", color: "text-amber-500 dark:text-amber-400", title: "เฝ้าระวังน้ำฝนรอระบายตามฤดูกาล", desc: "พื้นที่ลุ่มภาคกลางอาจมีน้ำท่วมขังชั่วคราวในช่วงฝนตกหนักต่อเนื่อง" };
            let pmValue = rand(28, 42, 1);
            let floodText = "ปานกลาง (ระบายตามระบบเทศบาล/อบต.)";
            let floodPct = rand(65, 82, 2);

            if (lat > 17.5) {
                region = "ภาคเหนือ";
                pmValue = rand(38, 65, 1);
                regionalAlert = { icon: "wind", color: "text-amber-500 dark:text-amber-400", title: "เฝ้าระวังฝุ่นควันตามฤดูกาลและน้ำป่า", desc: "ช่วง ก.พ.-เม.ย. ควรติดตามค่า PM2.5 และช่วงฤดูฝนควรระวังน้ำหลากในพื้นที่เชิงเขา" };
                floodText = "ต่ำ-ปานกลาง (เฝ้าระวังพื้นที่ริมลำน้ำ)";
            } else if (lng > 101.4 && lat > 14.1) {
                region = "ภาคตะวันออกเฉียงเหนือ (อีสาน)";
                pmValue = rand(26, 40, 1);
                regionalAlert = { icon: "sun", color: "text-sky-600 dark:text-sky-400", title: "สภาพภูมิอากาศแปรปรวนตามฤดูกาล", desc: "ฤดูฝนควรติดตามปริมาณน้ำในลำน้ำสาขา ส่วนฤดูแล้งอากาศโปร่งและค่าครองชีพไม่สูง" };
                floodText = "ต่ำ (ยกเว้นพื้นที่ลุ่มต่ำริมห้วย/แม่น้ำ)";
                floodPct = rand(72, 88, 2);
            } else if (lat < 11.5) {
                region = "ภาคใต้";
                pmValue = rand(14, 24, 1);
                regionalAlert = { icon: "cloud-rain", color: "text-amber-500 dark:text-amber-400", title: "เฝ้าระวังมรสุมและฝนตกชุก", desc: "อากาศบริสุทธิ์ตลอดปี แต่ช่วงมรสุม (พ.ค.-ธ.ค.) ควรติดตามประกาศเตือนคลื่นลมและน้ำท่วมฉับพลัน" };
                floodText = "ปานกลาง (เฝ้าระวังช่วงมรสุม)";
                floodPct = rand(60, 78, 2);
            } else if (lng > 100.8 && lat >= 11.5 && lat <= 14.1) {
                region = "ภาคตะวันออก";
                pmValue = rand(22, 36, 1);
                regionalAlert = { icon: "wind", color: "text-emerald-600 dark:text-emerald-400", title: "เขตพัฒนาเศรษฐกิจและชายฝั่งทะเล", desc: "มีลมทะเลถ่ายเท ระบบสาธารณูปโภคและเส้นทางคมนาคมหลักเชื่อมต่อสะดวก" };
            }

            const safety = rand(78, 91, 3);
            const env = Math.max(58, 100 - Math.round(pmValue * 0.6));
            const infra = rand(76, 92, 4);
            const transit = rand(70, 88, 5);
            const green = rand(75, 92, 6);
            const overall = Math.round((safety + env + infra + transit + green) / 5);

            const isLowRisk = overall >= 80;
            const totalVotes = rand(35, 140, 7);
            const c5 = Math.round(totalVotes * 0.48);
            const c4 = Math.round(totalVotes * 0.32);
            const c3 = Math.round(totalVotes * 0.13);
            const c2 = Math.round(totalVotes * 0.05);
            const c1 = Math.max(0, totalVotes - (c5 + c4 + c3 + c2));
            const avgRating = (((c5*5)+(c4*4)+(c3*3)+(c2*2)+(c1*1)) / totalVotes).toFixed(1);

            return {
                title: title,
                subtitle: `${province} (${region}) • พิกัด: ${lat.toFixed(4)}, ${lng.toFixed(4)}`,
                overall: overall,
                grade: overall >= 82 ? "น่าอยู่อาศัยระดับดีมาก (A)" : "น่าอยู่อาศัยระดับดี (B+)",
                riskBadge: isLowRisk 
                    ? { text: "เสี่ยงต่ำ", class: "bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border-emerald-500/30" }
                    : { text: "เสี่ยงปานกลาง", class: "bg-amber-500/15 text-amber-700 dark:text-amber-400 border-amber-500/30" },
                quick: { safety: `ดี (${safety}%)`, env: `ปานกลาง (${env}%)`, convenience: `ดี (${infra}%)` },
                scores: { safety, env, infra, transit, green },
                flood: { status: floodText, percent: floodPct },
                pm: { status: `${pmValue} µg/m³ (${pmValue <= 37 ? 'ปานกลาง-ดี' : 'เริ่มมีผลกระทบ'})`, percent: Math.max(45, 100 - pmValue) },
                hospital: `โรงพยาบาลประจำอำเภอ / รพ.รัฐใกล้เคียง (1.5 - 4.0 กม.)`,
                police: `สถานีตำรวจภูธร / จุดบริการประชาชนในพื้นที่ (1.2 กม.)`,
                transit: "รถโดยสารประจำทาง / ถนนสายหลักเชื่อมต่อจังหวัด",
                traffic: { status: "คล่องตัว (หนาแน่นเฉพาะช่วงเช้า-เย็นหน้าตลาด/โรงเรียน)", percent: transit },
                park: `สวนสาธารณะเทศบาล / ลานออกกำลังกายชุมชน (1.5 กม.)`,
                noise: `เงียบสงบ ~ ${rand(48, 60, 8)} dB`,
                alerts: [
                    regionalAlert,
                    { icon: "shield-check", color: "text-emerald-600 dark:text-emerald-400", title: "เครือข่ายความปลอดภัยชุมชน", desc: "ครอบคลุมพื้นที่ให้บริการของสถานีตำรวจ หน่วยกู้ชีพ 1669 และกล้อง CCTV จุดสำคัญ" }
                ],
                recommendations: [
                    `พื้นที่ใน ${province} (${region}) มีบรรยากาศชุมชนเป็นมิตร เหมาะกับการอยู่อาศัยและประกอบอาชีพ`,
                    "บันทึกเบอร์สายด่วนฉุกเฉิน 191 (ตำรวจ) และ 1669 (การแพทย์ฉุกเฉิน) ประจำจังหวัดไว้ใช้งาน",
                    "ตรวจสอบเส้นทางเข้า-ออก และไฟส่องสว่างซอยย่อยหากต้องเดินทางช่วงเวลากลางคืน",
                    "สามารถร่วมกดให้ดาวและรีวิวข้อมูลจริงด้านล่าง เพื่อช่วยอัปเดตข้อมูลให้คนในพื้นที่ได้"
                ],
                pins: [
                    { type: "safety", label: "สถานีตำรวจ / จุดตรวจชุมชน", top: "32%", left: "38%" },
                    { type: "health", label: "โรงพยาบาล / รพ.สต. ใกล้เคียง", top: "45%", left: "65%" },
                    { type: "risk", label: "จุดเฝ้าระวังจราจรและระบายน้ำ", top: "68%", left: "48%" }
                ],
                votes: {
                    total: totalVotes,
                    avg: avgRating,
                    counts: { 5: c5, 4: c4, 3: c3, 2: c2, 1: c1 },
                    reviews: [
                        { user: `คนในพื้นที่ (${province})`, rating: 5, tags: ["🛡️ ปลอดภัย ไฟสว่าง", "🍜 ของกินหาง่าย"], comment: `บรรยากาศดี ผู้คนเป็นมิตร เดินทางสะดวก มีตลาดและร้านค้าครบในชุมชน`, time: "1 วันที่แล้ว" },
                        { user: "ผู้เดินทางผ่านพื้นที่", rating: 4, tags: ["👍 เดินทางสะดวก"], comment: "ถนนหนทางดี สัญญาณโทรศัพท์และอินเทอร์เน็ตครอบคลุม", time: "3 วันที่แล้ว" }
                    ]
                }
            };
        }

        // GPS Geolocation Handler (Works anywhere in Thailand with Reverse Geocoding)
        function useCurrentLocation() {
            if (navigator.geolocation) {
                showToast('กำลังดึงพิกัด GPS ปัจจุบันของคุณ...');
                navigator.geolocation.getCurrentPosition(
                    async (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        
                        try {
                            const revUrl = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=th`;
                            const res = await fetch(revUrl);
                            const data = await res.json();
                            const addr = data.address || {};

                            const subdistrict = addr.suburb || addr.quarter || addr.village || addr.hamlet || "";
                            const district = addr.city_district || addr.district || addr.county || addr.town || "";
                            const province = addr.province || addr.state || addr.city || "ประเทศไทย";
                            const fullName = [subdistrict, district, province].filter(Boolean).join(', ') || "ตำแหน่งปัจจุบันของคุณ (GPS)";

                            const gpsKey = `gps_${lat.toFixed(3)}_${lng.toFixed(3)}`;
                            if (!locationData[gpsKey]) {
                                locationData[gpsKey] = generateThailandAreaProfile(fullName, province, lat, lng);
                            }
                            loadLocationData(gpsKey);
                            showToast(`ระบุพิกัดสำเร็จ: ${fullName}`);
                        } catch (e) {
                            const gpsKey = `gps_${lat.toFixed(3)}_${lng.toFixed(3)}`;
                            if (!locationData[gpsKey]) {
                                locationData[gpsKey] = generateThailandAreaProfile("ตำแหน่งปัจจุบันของคุณ (GPS)", "ประเทศไทย", lat, lng);
                            }
                            loadLocationData(gpsKey);
                            showToast('ระบุพิกัด GPS สำเร็จ!');
                        }
                    },
                    (error) => {
                        showToast('ไม่สามารถเข้าถึงตำแหน่งได้ ใช้ข้อมูลพื้นที่ตัวอย่าง');
                        loadLocationData('korat');
                    }
                );
            } else {
                showToast('เบราว์เซอร์ไม่รองรับ GPS Geolocation');
            }
        }

        // Toast Notification Helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toastMsg');
            msg.innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }
    </script>
</body>
</html>
